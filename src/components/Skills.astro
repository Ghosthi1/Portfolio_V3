---
// Trim or expand each list to match what you actually know
const skillGroups = [
  {
    category: 'Languages',
    skills: ['Rust', 'C#', 'JavaScript'],
  },
  {
    category: 'Game Dev',
    skills: ['Bevy', 'Unity', 'WebGPU', 'WGSL', 'ECS Architecture'],
  },
  {
    category: 'Embedded',
    skills: ['Raspberry Pi Pico', 'Embassy', 'USB HID'],
  },
  {
    category: 'Tooling',
    skills: ['Git', 'Linux', 'Cargo'],
  },
];
---

<section id="skills" class="py-24 px-6 md:px-12 lg:px-24 max-w-6xl mx-auto border-t border-gray-800">
  <div class="mb-12">
    <p class="text-orange-500 font-mono text-sm tracking-widest uppercase mb-2">Toolkit</p>
    <h2 class="text-4xl font-bold text-gray-50">Skills</h2>
  </div>

  <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10">
    {skillGroups.map((group) => (
      <div>
        <h3 class="text-xs font-mono text-orange-500 uppercase tracking-widest mb-5">
          {group.category}
        </h3>
        <ul class="flex flex-col gap-3">
          {group.skills.map((skill) => (
            <li class="flex items-center gap-2.5 text-gray-300 text-sm">
              <span class="w-1.5 h-1.5 rounded-full bg-orange-500 shrink-0" aria-hidden="true"></span>
              {skill}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>