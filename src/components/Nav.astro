---
const links = [
  { label: 'Projects', href: '#projects' },
  { label: 'Skills',   href: '#skills' },
  { label: 'About',    href: '#about' },
  { label: 'CV',   href: '/CV.pdf' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 backdrop-blur-md bg-gray-900/80 border-b border-gray-800">
  <nav class="max-w-6xl mx-auto px-6 md:px-12 lg:px-24 h-16 flex items-center justify-between">
    <a href="#home" class="font-mono text-orange-500 font-medium tracking-tight hover:text-orange-400 transition-colors">
      Callum_Forsyth<span class="text-gray-500">.dev</span>
    </a>

    <ul class="hidden md:flex items-center gap-8">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="text-sm text-gray-400 hover:text-orange-500 transition-colors duration-200 font-mono"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Mobile: just show the resume CTA -->
    <a
      href="/resume.pdf"
      class="md:hidden text-sm font-mono text-orange-500 border border-orange-500/40 hover:border-orange-500 px-3 py-1.5 rounded transition-colors"
    >
      CV
    </a>
  </nav>
</header>