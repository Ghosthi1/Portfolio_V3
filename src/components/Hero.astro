---
// Replace these placeholders with your real info
const name    = 'Callum Forsyth';
const tagline = 'Rust · Game Dev · Embedded Systems';
const bio     = "I'm a CS grad who gravitates toward low-level problems — writing Rust, building games from scratch, and getting hardware to do what I want. I care about software that's fast, explicit, and close to the metal.";
const github  = 'https://github.com/Ghosthi1';
---

<section id="home" class="min-h-screen flex flex-col justify-center px-6 md:px-12 lg:px-24 max-w-6xl mx-auto pt-16">
  <p class="text-orange-500 font-mono text-sm tracking-widest uppercase mb-4">Hello, I'm</p>

  <h1 class="text-5xl md:text-7xl font-bold text-gray-50 leading-tight mb-4">
    {name}
  </h1>

  <p class="text-xl md:text-2xl font-mono text-gray-400 mb-6">
    {tagline}
  </p>

  <p class="text-gray-400 max-w-xl leading-relaxed mb-10">
    {bio}
  </p>

  <div class="flex flex-wrap gap-4">
    <a
      href="#projects"
      class="px-6 py-3 bg-orange-500 hover:bg-orange-400 text-gray-900 font-semibold rounded-lg transition-colors duration-200"
    >
      View Projects
    </a>
    <a
      href={github}
      target="_blank"
      rel="noopener"
      class="px-6 py-3 border border-gray-600 hover:border-orange-500 hover:text-orange-500 text-gray-300 font-semibold rounded-lg transition-colors duration-200"
    >
      GitHub
    </a>
    <a
      href="/resume.pdf"
      class="px-6 py-3 border border-gray-600 hover:border-orange-500 hover:text-orange-500 text-gray-300 font-semibold rounded-lg transition-colors duration-200"
    >
      CV
    </a>
  </div>
</section>